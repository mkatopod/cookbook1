generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  user_id        Int        @id @default(autoincrement()) @map("user_id")
  email     String     @unique
  password  String
  role      String     @default("USER")
  cookbooks Cookbook[]
  recipes   Recipe[]

  @@map("users")
}

model Recipe {
  recipe_id           Int                @id @default(autoincrement()) @map("recipe_id")
  title        String
  instructions String
  authorId     Int
  cookbooks    CookbookRecipe[]
  ingredients  RecipeIngredient[]
  author       User               @relation(fields: [authorId], references: [user_id], onDelete: Cascade)

  @@map("recipes")
}

model Ingredient {
  ingredient_id       Int                @id @default(autoincrement()) @map("ingredient_id")
  name     String             @unique
  category String
  recipes  RecipeIngredient[]

  @@map("ingredients")
}

model RecipeIngredient {
  recipe_ingredient_id            Int        @id @default(autoincrement()) @map("recipe_ingredient_id")
  recipe_id      Int        @map("recipe_id")
  ingredient_id  Int        @map("ingredient_id")
  category_type String
  ingredient    Ingredient @relation(fields: [ingredient_id], references: [ingredient_id], onDelete: Cascade)
  recipe        Recipe     @relation(fields: [recipe_id], references: [recipe_id], onDelete: Cascade)

  @@map("recipe_ingredients")
}

model Cookbook {
  cookbook_id      Int              @id @default(autoincrement()) @map("cookbook_id")
  name    String
  date    DateTime         @default(now())
  user_id  Int              @map("user_id")
  recipes CookbookRecipe[]
  user    User             @relation(fields: [user_id], references: [user_id], onDelete: Cascade)

  @@map("cookbooks")
}

model CookbookRecipe {
  cookbook_recipe_id         Int      @id @default(autoincrement()) @map("cookbook_recipe_id")
  cookbook_id Int      @map("cookbook_id")
  recipe_id   Int      @map("recipe_id")
  cookbook   Cookbook @relation(fields: [cookbook_id], references: [cookbook_id], onDelete: Cascade)
  recipe     Recipe   @relation(fields: [recipe_id], references: [recipe_id], onDelete: Cascade)

  @@map("cookbook_recipes")
}

enum Role {
  USER
  ADMIN
}
